# Só o Cloudflare (pré-visualização) lê este arquivo; o GitHub Pages (produção) o ignora.
# O noindex abaixo mantém a cópia do workers.dev fora do Google. Não use este arquivo
# num deploy de produção no Cloudflare sem antes tirar o bloco X-Robots-Tag.
/*
  X-Robots-Tag: noindex, nofollow

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=604800
